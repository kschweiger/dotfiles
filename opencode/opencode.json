{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "default_agent": "plan",

  "permissions": [
    // Ask by default, including for unknown and MCP tools.
    // This replaces the legacy mcp_* rule.
    { "action": "*", "resource": "*", "effect": "ask" },

    // Read-only operations
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },

    // V2 combines write, edit, and patch.
    { "action": "edit", "resource": "*", "effect": "ask" },

    // V2 replaces bash with shell.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Allow only non-mutating Git inspection commands.
    // Commit, push, and other commands still require approval.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },

    // Require approval before launching subagents.
    { "action": "subagent", "resource": "*", "effect": "ask" },

    // Ask before accessing directories outside the workspace.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Preserve protection for environment files.
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" }
  ],

  "compaction": {
    "auto": true,
    "buffer": 12000
  },

  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".turbo/**",
      "coverage/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".direnv/**",
      "result/**"
    ]
  },

  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],

  "providers": {
    "company-litellm": {
      "name": "Company LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:COMPANY_LITELLM_URL}/v1",
        "apiKey": "{env:COMPANY_LITELLM_TOKEN}"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5"
        },
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5"
        }
      }
    }
  }
}
