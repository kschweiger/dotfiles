{
  "$schema": "https://opencode.ai/config.json",
  // Safer sharing posture for work/private repos
  "share": "disabled",
  "default_agent": "plan",
  "permission": {
    // Read-ish tools (usually safe)
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "todoread": "allow",
    // Write / execute tools (gate with approval)
    "write": "ask",
    "edit": "ask",
    "patch": "ask",
    "bash": "ask",
    "todowrite": "ask",
    // Be conservative with any external MCP tools by default
    "mcp_*": "ask",
    // git configuration
    "git": {
      "*": "allow",
      "commit *": "ask"
    }
  },
  // Keep context healthy in long sessions
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  // Reduce watcher noise
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".turbo/**",
      "coverage/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".direnv/**",
      "result/**" // useful on NixOS projects
    ]
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],
  "provider": {
    "company-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Company LiteLLM",
      "options": {
        "baseURL": "{env:COMPANY_LITELLM_URL}/v1",
        "apiKey": "{env:COMPANY_LITELLM_TOKEN}"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5"
        },
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5"
        }
      }
    }
  }
}
